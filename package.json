{
  "name": "onsective-enterprise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "(lsof -ti:3000 | xargs kill -9 2>/dev/null; true) && (node server.js & echo $! > /tmp/onsective-server.pid; trap 'kill $(cat /tmp/onsective-server.pid) 2>/dev/null' EXIT INT TERM; vite)",
    "dev:vite": "vite",
    "dev:server": "node server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.6.3",
    "google-spreadsheet": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.344.0",
    "nodemailer": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.4.2",
    "vite": "^7.3.1"
  }
}
